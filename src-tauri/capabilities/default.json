{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-code",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "[\\s\\S]*" },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--append-system-prompt",
            { "validator": "[\\s\\S]*" }
          ],
          "sidecar": false
        },
        {
          "name": "claude-code-readonly",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "[\\s\\S]*" },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit",
            "--append-system-prompt",
            { "validator": "[\\s\\S]*" }
          ],
          "sidecar": false
        },
        {
          "name": "claude-code-agent",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "[\\s\\S]*" },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--permission-mode",
            "acceptEdits",
            "--disallowedTools",
            "Bash",
            "--append-system-prompt",
            { "validator": "[\\s\\S]*" }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
