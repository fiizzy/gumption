{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "claude-windows",
  "description": "Runs the Claude Code CLI as the whiteboard agent. Without a codebase every tool is off; with one, Claude may only read and search.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "shell:allow-kill",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-version",
          "cmd": "claude",
          "args": [
            "--version"
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-codebase",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-model",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--model",
            {
              "validator": "^[A-Za-z0-9._:\\[\\]-]+$"
            },
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-codebase-model",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch",
            "--model",
            {
              "validator": "^[A-Za-z0-9._:\\[\\]-]+$"
            },
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
