{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "claude-windows",
  "description": "Runs the Claude Code CLI directly.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-code",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "claude-code-readonly",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "claude-code-agent",
          "cmd": "claude",
          "args": [
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--permission-mode",
            "acceptEdits",
            "--disallowedTools",
            "Bash",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
