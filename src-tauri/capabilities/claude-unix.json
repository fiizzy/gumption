{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "claude-unix",
  "description": "Runs the Claude Code CLI as the whiteboard agent through sh so its stdin is /dev/null: claude -p waits for stdin to close, and the shell plugin keeps it open forever. Without a codebase every tool is off; with one, Claude may only read and search.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "linux"
  ],
  "permissions": [
    "shell:allow-kill",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-version",
          "cmd": "sh",
          "args": [
            "-c",
            "command -v claude && claude --version"
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard",
          "cmd": "sh",
          "args": [
            "-c",
            "exec claude \"$@\" </dev/null",
            "claude",
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-codebase",
          "cmd": "sh",
          "args": [
            "-c",
            "exec claude \"$@\" </dev/null",
            "claude",
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch",
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-model",
          "cmd": "sh",
          "args": [
            "-c",
            "exec claude \"$@\" </dev/null",
            "claude",
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--tools=",
            "--model",
            {
              "validator": "^[A-Za-z0-9._:\\[\\]-]+$"
            },
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "whiteboard-codebase-model",
          "cmd": "sh",
          "args": [
            "-c",
            "exec claude \"$@\" </dev/null",
            "claude",
            "-p",
            {
              "validator": "[\\s\\S]*"
            },
            "--output-format",
            "stream-json",
            "--verbose",
            "--include-partial-messages",
            "--no-session-persistence",
            "--disallowedTools",
            "Bash,Edit,Write,NotebookEdit,WebFetch,WebSearch",
            "--model",
            {
              "validator": "^[A-Za-z0-9._:\\[\\]-]+$"
            },
            "--append-system-prompt",
            {
              "validator": "[\\s\\S]*"
            }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
